# 认证密码（必需）—— 登录口令，会以 SHA-256 校验
AUTH_PASSWORD=your_login_password

# AI Provider 默认配置（可在应用内设置页覆盖）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Tavily 搜索 API key
TAVILY_API_KEY=tvly-your_tavily_api_key

# 可选：Exa 管理端 Service Key（用于设置页展示 Exa 用量，与搜索用的 EXA_API_KEY 不同）
# EXA_SERVICE_KEY=your_exa_service_key

# 可选：bash 工具工作目录（默认进程 cwd；Docker 内为 /app/workspace）
# BASH_TOOL_WORKDIR=/app/workspace

# 可选：单次工具结果进入上下文的字节上限（默认 32768）。超出部分按头尾保留中间截断，
# 完整输出落盘并把路径返回给模型。调小可显著降低长会话的 token 累计。
# TOOL_OUTPUT_MAX_BYTES=32768

# 可选：日志级别（默认 info）
# LOG_LEVEL=info

# 可选：服务端口（默认 3000）
# PORT=3000
